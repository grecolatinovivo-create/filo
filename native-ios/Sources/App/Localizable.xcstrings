    "Fili finiti. Il percorso del Sarto viene rivelato.": {
      "extractionState": "manual",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Fili finiti. Il percorso del Sarto viene rivelato."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Out of threads. The Tailor's path is revealed."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Plus de fils. Le parcours du Tailleur est révélé."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sin hilos. Se revela el recorrido del Sastre."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Keine Fäden mehr. Der Weg des Schneiders wird enthüllt."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "线用完了。裁缝的路径揭晓。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Acabaram os fios. O caminho do Alfaiate é revelado."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "糸切れ。仕立て屋のルートが明かされます。"
          }
        }
      }
    },
