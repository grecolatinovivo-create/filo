    "Rigioca ogni puzzle uscito finora e sblocca i temi colorati con l'acquisto extra, una volta sola.": {
      "extractionState": "manual",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Rigioca ogni puzzle uscito finora e sblocca i temi colorati con l'acquisto extra, una volta sola."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Replay every puzzle so far and unlock the colorful themes with the extra purchase, once and for all."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rejouez chaque puzzle paru jusqu'ici et débloquez les thèmes colorés avec l'achat extra, une seule fois."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Vuelve a jugar cada puzzle hasta ahora y desbloquea los temas de colores con la compra extra, una sola vez."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Spiele jedes bisherige Rätsel erneut und schalte die bunten Themes mit dem Extra-Kauf frei, ein einziges Mal."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "重玩至今的每个谜题，一次性购买附加内容即可解锁彩色主题。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Rejogue cada quebra-cabeça até agora e libere os temas coloridos com a compra extra, de uma só vez."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これまでのパズルをすべて再プレイし、追加購入で一度きりカラフルなテーマを解放。"
          }
        }
      }
    },
