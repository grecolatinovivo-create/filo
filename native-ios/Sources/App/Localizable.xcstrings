    "Mossa non valida: casella già usata in questo filo.": {
      "extractionState": "manual",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mossa non valida: casella già usata in questo filo."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Invalid move: cell already used in this thread."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Coup invalide : case déjà utilisée dans ce fil."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Movimiento no válido: casilla ya usada en este hilo."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ungültiger Zug: Feld in diesem Faden bereits benutzt."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无效操作：该格已在本线中使用。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Jogada inválida: casa já usada neste fio."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "無効な操作：このマスはこの糸で使用済みです。"
          }
        }
      }
    },
    "Mossa non valida: la casella non è adiacente all'ultima.": {
