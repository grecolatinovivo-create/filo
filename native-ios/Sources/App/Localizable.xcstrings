    "⛔ Il filo non si riavvolge: ogni casella è per sempre.": {
      "extractionState": "manual",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "⛔ Il filo non si riavvolge: ogni casella è per sempre."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "⛔ The thread never rewinds: every cell is forever."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "⛔ Le fil ne se rembobine pas : chaque case est définitive."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "⛔ El hilo no se rebobina: cada casilla es para siempre."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "⛔ Der Faden lässt sich nicht zurückspulen: jedes Feld ist endgültig."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "⛔ 线不能回退：每一格都是永久的。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "⛔ O fio não volta: cada casa é para sempre."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "⛔ 糸は巻き戻せない。選んだマスは元に戻せません。"
          }
        }
      }
    },
    "💥 Superi la somma? Spezzato.": {
