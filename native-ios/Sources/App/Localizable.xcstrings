    },
    "Stessa misura del Sarto: %lld caselle. Cucito a regola d'arte.": {
      "extractionState": "manual",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Stessa misura del Sarto: %lld caselle. Cucito a regola d'arte."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Same length as the Tailor: %lld cells. Stitched to perfection."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Même mesure que le Tailleur : %lld cases. Cousu dans les règles de l'art."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La misma medida que el Sastre: %lld casillas. Cosido a la perfección."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Genau wie der Schneider: %lld Felder. Meisterhaft genäht."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "和裁缝一样长：%lld 格。缝得堪称典范。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mesma medida do Alfaiate: %lld casas. Costurado com maestria."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "仕立て屋と同じ長さ：%lld マス。見事な仕立てだ。"
          }
        }
      }
    },
    "A un soffio dal Sarto: %lld caselle di differenza. Ci sei quasi.": {
      "extractionState": "manual",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "A un soffio dal Sarto: %lld caselle di differenza. Ci sei quasi."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A whisker from the Tailor: %lld cells apart. So close."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "À un souffle du Tailleur : %lld cases d'écart. Vous y êtes presque."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "A un suspiro del Sastre: %lld casillas de diferencia. Casi lo tienes."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hauchdünn hinter dem Schneider: %lld Felder Unterschied. Fast geschafft."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "离裁缝就差一点：相差 %lld 格。就快成功了。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A um sopro do Alfaiate: %lld casas de diferença. Quase lá."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "仕立て屋まであと一歩：差は %lld マス。もう少し。"
          }
        }
      }
    },
    "Somma esatta! Il Sarto però l'ha cucita in %lld caselle. Domani allunghi il filo?": {
      "extractionState": "manual",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Somma esatta! Il Sarto però l'ha cucita in %lld caselle. Domani allunghi il filo?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Exact sum! But the Tailor stitched it in %lld cells. Longer thread tomorrow?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Somme exacte ! Mais le Tailleur l'a cousue en %lld cases. Un fil plus long demain ?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¡Suma exacta! Pero el Sastre la cosió en %lld casillas. ¿Alargas el hilo mañana?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Exakte Summe! Doch der Schneider brauchte nur %lld Felder. Morgen längerer Faden?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "总和正确！不过裁缝只用了 %lld 格。明天拉长线？"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Soma exata! Mas o Alfaiate costurou em %lld casas. Amanhã estica o fio?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "合計はぴったり！でも仕立て屋は %lld マスで。明日は糸を長く？"
          }
        }
      }
    },
    "🔥 2 di fila — il filo comincia a tenere.": {
      "extractionState": "manual",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
