    "Il suo percorso è qui sotto: studialo. Domani c'è un filo nuovo.": {
      "extractionState": "manual",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il suo percorso è qui sotto: studialo. Domani c'è un filo nuovo."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Its path is below: study it. Tomorrow brings a new thread."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Son parcours est en dessous : étudiez-le. Demain, un nouveau fil."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Su recorrido está abajo: estúdialo. Mañana hay un hilo nuevo."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sein Weg ist unten: studiere ihn. Morgen gibt es einen neuen Faden."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "它的路径就在下方，好好研究吧。明天有新的线。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O caminho dele está abaixo: estude-o. Amanhã tem um fio novo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "そのルートは下に。よく見て。明日は新しい糸だ。"
          }
        }
      }
    },
    "%lld caselle contro le sue %lld. Oggi il maestro sei tu.": {
      "extractionState": "manual",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
