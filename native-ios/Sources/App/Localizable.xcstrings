    "Collega le caselle con un filo continuo (niente diagonali) fino a fare ESATTAMENTE la Somma del Giorno.": {
      "extractionState": "manual",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Collega le caselle con un filo continuo (niente diagonali) fino a fare ESATTAMENTE la Somma del Giorno."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Connect the cells with one continuous thread (no diagonals) to make EXACTLY the Daily Sum."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Reliez les cases avec un fil continu (pas de diagonales) pour atteindre EXACTEMENT la Somme du Jour."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Conecta las casillas con un hilo continuo (sin diagonales) hasta lograr EXACTAMENTE la Suma del Día."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verbinde die Felder mit einem durchgehenden Faden (keine Diagonalen), um GENAU die Tagessumme zu erreichen."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用一条连续的线（不能走斜线）连接格子，凑出与今日之和完全相等的数。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ligue as casas com um fio contínuo (sem diagonais) até formar EXATAMENTE a Soma do Dia."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "マスを一本の連続した糸でつなぎ（斜めは不可）、今日の合計にちょうど一致させよう。"
          }
        }
      }
    },
