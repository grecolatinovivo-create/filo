            "value": "Même une défaite fait une belle histoire. Mettez quelqu'un au défi de faire mieux."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Incluso una derrota es una buena historia. Reta a alguien a hacerlo mejor."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auch eine Niederlage ist eine gute Geschichte. Fordere jemanden heraus."
          }
        },
        "zh-Hans": {
