          "stringUnit": {
            "state": "translated",
            "value": "最後の糸です。切ると今日のゲームは終了します。"
          }
        }
      }
    },
    "Un filo strappato non si ricuce: te ne resterà 1.": {
      "extractionState": "manual",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un filo strappato non si ricuce: te ne resterà 1."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A cut thread can't be resewn: you'll have 1 left."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un fil coupé ne se recoud pas : il vous en restera 1."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un hilo cortado no se vuelve a coser: te quedará 1."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein abgerissener Faden lässt sich nicht wieder nähen: dir bleibt 1."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "剪断的线无法再缝：你还剩 1 根。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um fio cortado não se costura de novo: sobrará 1."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "切った糸は縫い直せません。残り 1 本になります。"
          }
        }
      }
    },
