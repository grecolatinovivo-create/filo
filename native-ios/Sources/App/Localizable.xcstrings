    "Il primo FILO è quello di oggi.\nDa domani ritrovi qui gli scorsi.": {
      "extractionState": "manual",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il primo FILO è quello di oggi.\nDa domani ritrovi qui gli scorsi."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The first FILO is today's.\nFrom tomorrow you'll find the past ones here."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le premier FILO est celui d'aujourd'hui.\nDès demain, retrouvez ici les précédents."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
