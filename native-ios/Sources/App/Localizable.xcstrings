          "stringUnit": {
            "state": "translated",
            "value": "Es el último hilo: cortarlo termina la partida de hoy."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es ist der letzte Faden: ihn abzureißen beendet das heutige Spiel."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这是最后一根线：剪断它就结束今天的对局。"
