    "Hai tre fili: se superi la somma il filo si spezza, se resti senza uscite si annoda.": {
      "extractionState": "manual",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Hai tre fili: se superi la somma il filo si spezza, se resti senza uscite si annoda."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You have three threads: go over the target and the thread breaks; run out of moves and it knots."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous avez trois fils : si vous dépassez la somme, le fil se rompt ; si vous n'avez plus d'issue, il se noue."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tienes tres hilos: si te pasas de la suma, el hilo se rompe; si te quedas sin salidas, se anuda."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du hast drei Fäden: Überschreitest du die Summe, reißt der Faden; gibt es keinen Ausweg mehr, verknotet er sich."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你有三根线：超过总和，线会断；无路可走，线会打结。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você tem três fios: se passar da soma, o fio rompe; se ficar sem saída, ele dá nó."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "糸は3本。合計を超えると糸が切れ、行き止まりになると結ばれます。"
          }
        }
      }
    },
    "Più caselle usi, più stelle ottieni: supera il Sarto per la medaglia.": {
      "extractionState": "manual",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Più caselle usi, più stelle ottieni: supera il Sarto per la medaglia."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The more tiles you use, the more stars you earn: beat the Tailor for the medal."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Plus vous utilisez de cases, plus vous gagnez d'étoiles : battez le Tailleur pour la médaille."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuantas más casillas uses, más estrellas consigues: supera al Sastre para ganar la medalla."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Je mehr Felder du nutzt, desto mehr Sterne bekommst du: Schlag den Schneider für die Medaille."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用的格子越多，星星越多：超过裁缝即可获得奖牌。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Quanto mais casas usar, mais estrelas ganha: supere o Alfaiate para levar a medalha."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "使うマスが多いほど星が増えます。仕立て屋を上回ればメダルです。"
          }
        }
      }
    },
